{
  "name": "f1-pulse",
  "version": "1.0.0",
  "description": "F1 Pulse — Formula 1 Schedule & Championship Tracker",
  "private": true,
  "scripts": {
    "cap:init": "npx cap init \"F1 Pulse\" \"com.f1pulse.app\" --web-dir www",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "build:android": "cd android && gradlew.bat assembleDebug",
    "build:all": "npm run cap:sync && npm run build:android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "keywords": [
    "f1",
    "formula1",
    "motorsport",
    "android",
    "capacitor"
  ],
  "author": "",
  "license": "MIT"
}
